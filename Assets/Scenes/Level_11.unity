    - target: {fileID: 5290922331253046447, guid: 1281eb9a784e2c14f8be6b17783ef487, type: 3}
      propertyPath: m_text
      value: "\u041D\u043E\u0432\u044B\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
        \u2014 \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0442\u043E\u0440. \n\u0412\u0441\u0442\u0430\u043D\u044C
        \u0432 \u043F\u043E\u0442\u043E\u043A \u0432\u043E\u0437\u0434\u0443\u0445\u0430:
